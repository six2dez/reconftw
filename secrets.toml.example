# secrets.toml.example — template for reconFTW v2 secret material.
#
#   cp secrets.toml.example secrets.toml      # secrets.toml is gitignored
#   reconftw recon --target example.com        # picked up as config layer 6
#   reconftw --secrets /path/to/secrets.toml … # or name it explicitly
#
# This file is config layer 6 of 8: it overrides reconftw.toml / --config and is
# overridden only by RECONFTW_* environment variables (layer 7) and CLI flags
# (layer 8). Any key below can also be set from the environment, e.g.
#   RECONFTW_API_KEYS_SHODAN=…  RECONFTW_MCP_API_KEY=…  RECONFTW_AI_OPENAI_KEY=…
# (the env mapper splits only the first underscore after the section name, so
# nested tables such as notifications.slack.* must be set in a file).
#
# Every key listed here is a log.Secret-typed field in internal/core/config:
# its value is redacted from every log line, from `reconftw config show`, from
# `reconftw migrate --dry-run` and from workspace config snapshots.
# Leave a key out (or empty) to disable the integration that needs it.

[api_keys]
shodan   = ""   # Shodan — passive port data, smap
whoisxml = ""   # WhoisXML — reverse-whois / reverse-IP pivots
pdcp     = ""   # ProjectDiscovery Cloud Platform — nuclei/subfinder cloud sources

[notifications.slack]
channel     = ""   # not a secret, kept here for convenience
webhook_url = ""   # must start with https://

[notifications.telegram]
bot_token = ""
chat_id   = ""     # not a secret

[notifications.discord]
webhook_url = ""   # must start with https://

[ai]
openai_key    = ""   # only when ai.provider = "openai"
anthropic_key = ""   # only when ai.provider = "anthropic"

[mcp]
api_key = ""   # Bearer token for `reconftw mcp serve`; 16–256 chars, e.g. `openssl rand -hex 32`

# Not secrets, but token FILES are referenced from [paths] rather than inlined:
#   [paths]
#   github_tokens = "/path/to/.github_tokens"   # one token per line
#   gitlab_tokens = "/path/to/.gitlab_tokens"
# Keep those files out of version control too.
