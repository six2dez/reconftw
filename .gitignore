#Ignoring output directories
Recon/
# Root-only — do NOT shadow internal/core/output (Phase 3 plan 03-03).
/output/
.obsidian/
test/
.trunk/
.vscode/
.cache/

#Ignoring compressed files
*.tar
*.tar.*
*.zip
.DS_Store
install.log
reconftw.cfg-personal

# Secrets and credential-shaped files (never commit)
secrets.cfg
secrets.cfg.*
!secrets.cfg.example

# v2 secret material — API keys live here (config layer 6). Never commit it.
secrets.toml
secrets.toml.*
!secrets.toml.example

# A reconftw.toml in the repo root is config layer 4 and IS auto-loaded, so a
# personal one would silently apply to anyone running the binary from a checkout
# (and would leak local paths). Keep it local.
/reconftw.toml
.env
.env.*
!.env.example
.env.cache/
*.tokens
**/*_tokens*
**/.github_tokens
*.pem
*.key
.shodan.cfg

documentation/

# Vendored wordlists that are stored compressed in-repo (expanded on-demand)
data/wordlists/subdomains.txt

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
*_override.tf
override.tf.json
*_override.tf.json
.terraformrc
terraform.rc

.claude
.planning/

# Spike PoC — generated outputs (Phase 1 ADR)
spike/go/out/
spike/python/out/*.jsonl
spike/python/out/*.log
spike/python/out/*.err
spike/python/out/*.tmp.*
spike/python/build/
spike/python/dist/*.spec
spike/python/__pycache__/
spike/python/src/**/__pycache__/
spike/python/tests/__pycache__/
spike/python/.pytest_cache/
spike/go/bin/
spike/python/.venv/
spike/comparison.json
spike/corpus/.tokens.*
spike/baselines/.regen-*
spike/go/.spike_session_start
spike/python/.spike_session_start
spike/.spike_sessions.log
out/

# v2 Go kernel build outputs (Phase 3+)
bin/
coverage.out
coverage-lib.out
# `go build ./...` writes the interfaces_check binary into the repo root when run
# without -o. Ignore it (the binary is just a verification scaffold; verify-0002.sh
# builds it explicitly to /tmp/).
/interfaces_check
# `reconftw kernel-demo` (Plan 06) writes workspaces/<target>-<timestamp>/ when
# run from the repo root. Phase 4 plan-01 deletes the kernel-demo subcommand,
# but keep workspaces/ ignored for production users running `reconftw run` etc.
workspaces/
# Stray Go binary built into repo root when running `go build ./cmd/reconftw`
# without -o. Production builds use `make build` → bin/reconftw.
/reconftw


# --- Phase 11 cleanup: runtime artifacts + separate experimentation (NEVER commit) ---
# reconftw-web / web experimentation (PROJECT.md: "no parte de v2.0"; node_modules-heavy)
# NOTE: keep these anchored to the repo root with a leading slash. A bare, unanchored
# `web/` also matches internal/modules/web/ (the Go web module) and silently un-tracks it.
# A TRAILING slash (`/reconftw-web/`) matches ONLY a directory — but the local build also
# emits a ~26MB `reconftw-web` compiled binary (a FILE) at the repo root. Anchor WITHOUT a
# trailing slash so the pattern matches both the file binary and the experimentation dir.
/web/
/reconftw-web
# runtime data: SQLite store, master key (SECRET), caches, manifests
data/
# stray scratch + local config
.config/
.planning.bak-*/
reconftw.cfg.local
# stray per-target scan outputs dropped in the repo root by a manual run.
# Pattern, not a name: the previous line hard-coded a real target's domain,
# which put it in the published tree for anyone reading .gitignore.
/*.com.txt
/*.net.txt
/*.org.txt
internal/core/backend/example.com.txt
# stray binary from `go build ./cmd/reconftw` without -o (prod uses make build → bin/)
cmd/reconftw/reconftw
