#############################################
#		reconFTW secrets template			#
#############################################
#
# Copy to secrets.cfg and fill in values:
#   cp secrets.cfg.example secrets.cfg
#   chmod 600 secrets.cfg
#
# Loaded automatically by reconftw.sh (and reconftw_mcp/scripts/run_function.sh)
# after reconftw.cfg. Environment variables take precedence over this file.
#
# Never commit secrets.cfg — it is listed in .gitignore.
# See SECURITY.md for Docker (-e flags) and CI patterns.

# =============================================================================
# Recon API keys (also referenced in reconftw.cfg with ${VAR:-} fallbacks)
# =============================================================================

# Shodan API key — health-check / optional passive enrichment
#SHODAN_API_KEY="your_shodan_api_key"

# WhoisXML API — ip_info() reverse IP, WHOIS, geolocation (modules/osint.sh)
#WHOISXML_API="your_whoisxml_api_key"

# ProjectDiscovery Cloud Platform — required for asnmap when ASN_ENUM=true
#PDCP_API_KEY="your_pdcp_api_key"

# VirusTotal — optional; surfaced in --health-check key status
#VIRUSTOTAL_API_KEY="your_virustotal_api_key"

# =============================================================================
# Vulnerability callback servers (modules/vulns.sh)
# =============================================================================

# Blind XSS callback host (dalfox -b), e.g. xss.report, xsshunter, interact.sh
#XSS_SERVER="your.xss.callback.host"

# SSRF / collaborator callback (ffuf SSRF checks, config/ssrf_payloads.txt)
# Examples: Burp Collaborator, interactsh, oast.pro
#COLLAB_SERVER="your.collaborator.host"

# =============================================================================
# GitHub / GitLab tokens (file paths — one token per line)
# Default paths from reconftw.cfg: ${tools}/.github_tokens, ${tools}/.gitlab_tokens
# Used by: github_dorks, github_repos, github_leaks, github_actions_audit (gato),
#          github-subdomains, gitlab-subdomains, github-endpoints
#
# Create token files instead of putting tokens here:
#   echo "ghp_xxxxxxxx" > "$HOME/Tools/.github_tokens"
#   chmod 600 "$HOME/Tools/.github_tokens"
#
# Optional single-token env aliases (health-check / some tools):
#GITHUB_TOKEN="ghp_xxxxxxxx"
#GITLAB_TOKEN="glpat-xxxxxxxx"

# Override token file locations if needed:
#GITHUB_TOKENS="${HOME}/Tools/.github_tokens"
#GITLAB_TOKENS="${HOME}/Tools/.gitlab_tokens"

# =============================================================================
# Notifications
# =============================================================================

# Slack file upload when SENDZIPNOTIFY=true (modules/core.sh)
#slack_channel="C0123456789"
#slack_auth="xoxb-your-slack-bot-token"

# ProjectDiscovery notify — configure webhooks in YAML (install.sh seeds a template):
#   ~/.config/notify/provider-config.yaml
# Supported keys in that file include slack_webhook_url, discord_webhook_url,
# telegram_apikey, telegram_chat_id (see Docker/notify.conf for examples).
#
# Optional env aliases redacted in logs (REDACT_VARS in modules/core.sh):
#SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"
#DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/XXX/YYY"

# =============================================================================
# AI — remote inference only (lib/ai, reconftw -y/--ai)
# No local GPU / Ollama required when AI_REMOTE_ONLY=true (default in reconftw.cfg)
# =============================================================================

# OpenAI-compatible API endpoint (vLLM, LiteLLM, OpenAI, hosted unsloth, etc.)
# `export` is optional — reconftw.sh and lib/reconftw_config.py re-export for child processes
AI_BASE_URL="https://api.openai.com/v1"

# Primary API key passed to lib/ai/cli.py (--api-key)
AI_API_KEY="sk-your-remote-api-key"

# Standard provider env aliases (used when AI_API_KEY is empty):
#OPENAI_API_KEY="sk-your-openai-key"
#ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# Optional overrides (non-secret; defaults live in reconftw.cfg):
AI_PROVIDER="openai_compatible"   # openai_compatible|openai|anthropic|mock
AI_MODEL="gpt-4o-mini"
AI_REMOTE_ONLY="true"             # block local Ollama / model pull
AI_SKIP_HEALTHCHECK="false"       # set true if endpoint blocks /models probe
# When AI_AUTO_ENABLE=true in reconftw.cfg, scans auto-run AI if keys/URL are set below

# Offline / CI tests only — no network:
#AI_PROVIDER="mock"

# =============================================================================
# MCP server (reconftw-mcp / uvx) — paths, not secrets
RECONFTW_ROOT="/path/to/reconftw"   # git checkout with reconftw.sh
RECONFTW_TOOLS="${HOME}/Tools"      # external tools from install.sh

# =============================================================================
# Faraday (optional — FARADAY=true in reconftw.cfg)
# Uses faraday-cli auth from your shell; no keys stored in reconftw by default.
# =============================================================================

# FARADAY_WORKSPACE is set in reconftw.cfg, not here.
